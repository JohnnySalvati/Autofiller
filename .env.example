# .env de produccion de AutoFiller. Se copia a la raiz del repo EN LA VM y se completa
# ahi; nunca va a git. Lo lee docker compose (env_file en docker-compose.prod.yml).
#
# IMPORTANTE: las variables opcionales van COMENTADAS, no vacias. docker compose pasa una
# variable vacia como cadena vacia, y una cadena vacia NO es lo mismo que ausente: pisa el
# default del codigo. Con AUTOFILLER_TAMANIO_MAXIMO_MB= (vacia) el servidor ni siquiera
# arranca, porque int("") revienta al importar main.py.
#
# Todas las variables son del servidor de extraccion. Las del agente
# (AUTOFILLER_ORIGENES, AUTOFILLER_CHROME, AUTOFILLER_PERFIL_CHROME,
# AUTOFILLER_PUERTO_CDP) se configuran en la PC del operador, no aca.

# --- Lectura de comprobantes en foto -----------------------------------------------
# Hay dos motores y con CUALQUIERA de los dos alcanza. Sin ninguno, el servidor arranca
# igual y lee PDFs, pero no fotos, y la web lo avisa con el chip "Fotos: no" -- que es
# facil no mirar. El chip dice cual quedo activo.

# OCR de Google Cloud Vision: el camino por defecto. Gratis hasta 1000 paginas por mes
# y devuelve siempre el mismo texto. Es el que conviene tener puesto.
GOOGLE_VISION_API_KEY=

# Modelo de vision de Claude: el respaldo, para cuando el OCR falla o devuelve algo que
# los regex de ARCA no parsean. Se paga por comprobante.
ANTHROPIC_API_KEY=

# Que motor usa el camino de foto: auto (OCR y, si no sirve, el modelo), ocr o vision.
# Forzarlo sirve para medir uno contra otro sobre comprobantes reales. Con "ocr" no hay
# respaldo: si el OCR no puede, el comprobante vuelve con error.
#AUTOFILLER_MOTOR_LECTURA=auto

# Modelo de vision y esfuerzo. Defaults: claude-opus-5 y medium. Se bajan a
# claude-sonnet-5 o claude-haiku-4-5 si el costo por comprobante pesa, sin tocar codigo.
#AUTOFILLER_MODELO_VISION=claude-sonnet-5
#AUTOFILLER_ESFUERZO_VISION=medium

# Tope por archivo, en MB. Default 25. Si se sube, hay que subir tambien el
# client_max_body_size del server block de srv-nginx (ver docs/DEPLOYMENT.md § 3).
#AUTOFILLER_TAMANIO_MAXIMO_MB=25

# Nivel de log. INFO deja ver los tokens y el costo de cada llamada de vision.
AUTOFILLER_LOG=INFO
